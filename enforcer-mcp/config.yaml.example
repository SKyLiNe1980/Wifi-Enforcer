# Enforcer-MCP server config — copy to config.yaml and customize.
#
# IMPORTANT: bearer_token_hex must match the one in the cockpit's MCP tab
# (// status → REGENERATE generates it; COPY copies it to clipboard).
# Until 1B.2 wires automatic sync, you paste it in manually.
#
# bind: 127.0.0.1 = loopback only (same device — e.g. cockpit's own chroot).
# bind: 0.0.0.0   = exposed to all interfaces including Tailscale. This is
# what you want on a REMOTE swarm node so the cockpit's health probe over
# tailnet can reach the /health endpoint. Combine with strong
# bearer_token + Tailscale ACLs.

server:
  host: "0.0.0.0"
  port: 8765
  mcp_path: "/mcp"
  bearer_token_hex: "REPLACE_WITH_64_HEX_CHARS_FROM_COCKPIT_MCP_TAB"
  require_token: true
  # Cap audit log to N most-recent entries. Server trims on every insert.
  audit_max_entries: 2000
  # Optional CORS allowlist for the /audit/since + /health endpoints when
  # called from React Native Web. Leave empty for loopback-only deploys.
  allowed_origins: []

# ─── Session manager (Phase 1C) ──────────────────────────────────────
# Per-session PTY ring buffer + concurrent session caps. Defaults give
# ~1 MiB worst-case memory (16 × 64 KiB) which is fine even on a phone.
sessions:
  ring_cap_bytes: 65536   # 64 KiB scrollback per session
  max_sessions: 16        # registry-wide cap; oldest exited GC'd first

tools:
  # ─── External tools (subprocess.run) ─────────────────────────────────
  - name: exec_command
    description: "Run a shell command on this node (root inside chroot)."
    command_template: "{cmd}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["cmd"],
        "properties": {
          "cmd": {"type": "string", "description": "Command to execute"}
        }
      }
    wrap_mode: none
    timeout_sec: 60

  - name: list_ifaces
    description: "List wireless interfaces with mode (managed/monitor) and channel."
    command_template: "iw dev | awk '/Interface|type|channel/ {print}'"
    arg_schema_json: |
      {"type": "object", "properties": {}}
    wrap_mode: none
    timeout_sec: 5

  - name: set_monitor_mode
    description: "Put a wireless interface into monitor mode via airmon-ng."
    command_template: "airmon-ng start {iface}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["iface"],
        "properties": {
          "iface": {"type": "string", "description": "e.g. wlan2"}
        }
      }
    wrap_mode: none
    timeout_sec: 15

  - name: set_channel
    description: "Lock a monitor-mode interface to a specific channel (1..196)."
    command_template: "iw dev {iface} set channel {channel}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["iface", "channel"],
        "properties": {
          "iface": {"type": "string"},
          "channel": {"type": "integer", "minimum": 1, "maximum": 196}
        }
      }
    wrap_mode: none
    timeout_sec: 5

  # ─── Internal tools (in-process Python handlers) ─────────────────────
  - name: read_command_logs
    description: "Read recent MCP server audit log entries (own log, not cockpit)."
    command_template: "__internal:read_command_logs"
    arg_schema_json: |
      {
        "type": "object",
        "properties": {
          "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}
        }
      }
    wrap_mode: none
    timeout_sec: 5

  - name: list_attack_profiles
    description: "Return attack profiles available on this node."
    command_template: "__internal:list_attack_profiles"
    arg_schema_json: |
      {"type": "object", "properties": {}}
    wrap_mode: none
    timeout_sec: 5

  - name: run_attack_profile
    description: "Run a named attack profile (stub in 1B)."
    command_template: "__internal:run_attack_profile"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["profile_name"],
        "properties": {
          "profile_name": {"type": "string"},
          "iface": {"type": "string"},
          "bssid": {"type": "string"},
          "count": {"type": "integer"}
        }
      }
    wrap_mode: none
    timeout_sec: 600

  - name: start_session
    description: "Start a long-lived PTY-backed session (interactive curses tools, REPLs, msfconsole). Returns a session_id you pass to read/write/stop."
    command_template: "__internal:start_session"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": {"type": "string", "description": "Shell command to run inside the PTY (bash -c)"},
          "label": {"type": "string", "description": "Optional human-readable label for list_sessions"},
          "cols": {"type": "integer", "minimum": 20, "maximum": 500, "default": 120},
          "rows": {"type": "integer", "minimum": 5, "maximum": 200, "default": 32}
        }
      }
    wrap_mode: none
    timeout_sec: 10

  - name: write_stdin
    description: "Send bytes (e.g. a command line or single keypress) to a running session's stdin. Appends a newline by default."
    command_template: "__internal:write_stdin"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["session_id", "data"],
        "properties": {
          "session_id": {"type": "string"},
          "data": {"type": "string"},
          "newline": {"type": "boolean", "default": true, "description": "Append \\n if data does not already end with one"}
        }
      }
    wrap_mode: none
    timeout_sec: 5

  - name: read_session
    description: "Read session output. Two modes — TAIL (default, returns last `tail_bytes`) or CURSOR (pass `since_byte` from previous response's `next_cursor` to get ONLY new bytes since then; ideal for incremental polling by LLM agents). Always returns `next_cursor` + `truncated` flag (true if you fell behind the ring buffer)."
    command_template: "__internal:read_session"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["session_id"],
        "properties": {
          "session_id": {"type": "string"},
          "tail_bytes": {"type": "integer", "default": 4096, "minimum": 0, "maximum": 65536, "description": "Tail-mode only — ignored when since_byte is set"},
          "since_byte": {"type": "integer", "minimum": 0, "description": "Cursor-mode: return only bytes whose cumulative offset is >= this value. Use the `next_cursor` from the previous read."},
          "clear": {"type": "boolean", "default": false, "description": "Empty the ring buffer after reading (does not reset next_cursor)"}
        }
      }
    wrap_mode: none
    timeout_sec: 5

  - name: stop_session
    description: "Terminate a session and its child process group (killpg). Defaults to SIGTERM with a 2 s grace then SIGKILL."
    command_template: "__internal:stop_session"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["session_id"],
        "properties": {
          "session_id": {"type": "string"},
          "signal": {
            "type": "string",
            "enum": ["SIGTERM", "SIGINT", "SIGHUP", "SIGKILL", "SIGQUIT"],
            "default": "SIGTERM"
          }
        }
      }
    wrap_mode: none
    timeout_sec: 10

  - name: list_sessions
    description: "List every PTY session known to this node (running + recently exited). Includes pid, label, command, buffer size, total bytes."
    command_template: "__internal:list_sessions"
    arg_schema_json: |
      {"type": "object", "properties": {}}
    wrap_mode: none
    timeout_sec: 5

  - name: resize_session
    description: "Resize a session's PTY window (TIOCSWINSZ). Sends SIGWINCH to the child so curses TUIs (wifite, htop, vim) repaint cleanly."
    command_template: "__internal:resize_session"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["session_id", "cols", "rows"],
        "properties": {
          "session_id": {"type": "string"},
          "cols": {"type": "integer", "minimum": 20, "maximum": 500},
          "rows": {"type": "integer", "minimum": 5, "maximum": 200}
        }
      }
    wrap_mode: none
    timeout_sec: 5

  # ─── Remote self-update ───────────────────────────────────────────────
  # Lets the cockpit push a .deb upgrade to a node over MCP, no SSH. The
  # updater runs detached (dpkg restarts enforcer-mcp), so the tool returns
  # {status: scheduled} immediately with the pre-upgrade version + a log
  # path. Poll /health or `dpkg-query` after ~30s to confirm the new build.
  - name: self_update
    description: "Pull + install this node's own enforcer-node .deb update, then restart the MCP service. If deb_url is given it's fetched and dpkg-installed; otherwise apt upgrades the package from its configured repo (ENFORCER_UPDATE_URL env is used when deb_url is omitted). Runs detached and returns immediately with the pre-upgrade version."
    command_template: "__internal:self_update"
    arg_schema_json: |
      {
        "type": "object",
        "properties": {
          "package": {"type": "string", "default": "enforcer-node", "description": "dpkg package name to upgrade."},
          "deb_url": {"type": "string", "description": "Optional direct URL to a .deb. When set, downloaded + dpkg -i'd instead of apt."},
          "apt": {"type": "boolean", "description": "Force apt-upgrade mode. Defaults to true when deb_url is absent."},
          "restart": {"type": "boolean", "default": true, "description": "Restart enforcer-mcp after install."}
        }
      }
    wrap_mode: none
    timeout_sec: 30


  # ─── wpa-sec.stanev.org integration ───────────────────────────────────────
  # Three-tool wrapper around the wpasec-upload CLI helper. wpa-sec only
  # accepts PMKIDs (not 4-way handshakes) AND only files with radiotap
  # headers — airodump-ng output usually fails on both counts. The helper
  # auto-converts .22000 → .cap (which wpa-sec WILL accept despite the
  # name suggesting otherwise) and uploads via curl.
  #
  # Common Hermes flow:
  #   1. capture PMKIDs with hcxdumptool → /tmp/cap.pcapng
  #   2. wpasec_preview {file:/tmp/cap.pcapng}  → confirms parseable
  #   3. wpasec_upload  {file:/tmp/cap.pcapng}  → submits to community

  - name: wpasec_preview
    description: "DRY-RUN a wpa-sec.stanev.org upload — shows what hashes would be submitted without actually uploading. No API key required. Auto-converts .22000/.pcapng/.cap inputs."
    command_template: "wpasec-upload -n {file}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "description": "Absolute path to a .cap, .pcap, .pcapng, or .22000 file containing PMKIDs"
          }
        }
      }
    wrap_mode: none
    timeout_sec: 30

  - name: wpasec_upload
    description: "Upload a WPA capture to wpa-sec.stanev.org for community-distributed PMKID cracking. Reads API key from ~/.wpasec (set via wpasec_save_key once). Auto-converts .22000 → .cap. PMKID-only — 4-way handshakes are ignored by wpa-sec."
    command_template: "wpasec-upload {file}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "description": "Absolute path to the capture file"
          }
        }
      }
    wrap_mode: none
    timeout_sec: 120

  - name: wpasec_save_key
    description: "Persist the wpa-sec.stanev.org API key (32-char hex, from your account page) to ~/.wpasec. Subsequent wpasec_upload calls will use it automatically. One-time setup per node."
    command_template: "wpasec-upload -k {key} -s"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$",
            "description": "32 hex characters from your wpa-sec.stanev.org account dashboard"
          }
        }
      }
    wrap_mode: none
    timeout_sec: 5

  # ─── Cloud OTA registry (Upstash Redis-as-registry) ──────────────────
  # First-class MCP tools around the enforcer-cloud-* shell helpers so
  # Hermes (or any LLM agent) can drive fleet OTA updates by prompt
  # instead of having to shell out via exec_command. Full audit trail
  # per invocation, JSON-schema-validated args, safer than raw bash.
  #
  # All these read Upstash creds from the same cascade as the CLI:
  #   /etc/enforcer-mcp/cloud.env → ~/.enforcer-cloud.env → env vars.
  # If creds are missing the tool fails cleanly with exit 2.

  - name: cloud_status
    description: "Show what's currently in the Upstash OTA registry (signal, latest meta, previous meta) and what version is installed locally. Read-only, safe to call with the read-only Upstash token."
    command_template: "enforcer-cloud-status --json"
    arg_schema_json: |
      {"type": "object", "properties": {}}
    wrap_mode: none
    timeout_sec: 15

  - name: cloud_pull
    description: "Self-update this node from the cloud OTA registry. Fetches enforcer:mcp:deb:blob:<signal-version>, sha256-verifies it against the meta record, then dpkg installs. No-op if the node is already at the cloud version, unless force=true."
    command_template: "enforcer-cloud-pull {flags}"
    arg_schema_json: |
      {
        "type": "object",
        "properties": {
          "flags": {
            "type": "string",
            "default": "",
            "description": "Extra CLI flags. Common: '--force' to reinstall same version, '--dry-run' to download + verify without dpkg -i.",
            "enum": ["", "--force", "--dry-run"]
          }
        }
      }
    wrap_mode: none
    timeout_sec: 120

  - name: cloud_rollback_local
    description: "Reinstall the PREVIOUS version stored in the cloud registry on THIS node only. Does not touch the cloud's latest pointer — other nodes keep pulling the current release. Use for surgical single-node rollback after a bad deploy."
    command_template: "enforcer-cloud-rollback --local --force"
    arg_schema_json: |
      {"type": "object", "properties": {}}
    wrap_mode: none
    timeout_sec: 120

  - name: cloud_snapshot
    description: "Dump every enforcer:mcp:* key from Upstash to a portable gzipped JSON file. Full-fidelity backup; complements Upstash's native mgmt-API backups. Default output path is /var/lib/enforcer-mcp/snapshots/<UTC>.json.gz. Returns the file path on stdout."
    command_template: "enforcer-cloud-snapshot {out_flag}"
    arg_schema_json: |
      {
        "type": "object",
        "properties": {
          "out_flag": {
            "type": "string",
            "default": "",
            "description": "Optional explicit output flag like '--out /path/to/file.json.gz'. Leave empty for auto-named snapshot in /var/lib/enforcer-mcp/snapshots/. Pass '--dry-run' to count matching keys without downloading."
          }
        }
      }
    wrap_mode: none
    timeout_sec: 60

  - name: cloud_restore
    description: "Restore an enforcer:mcp:* snapshot back into Upstash. Refuses to run if live keys differ from snapshot (unless force=true). Signal + latest pointer are written last, so a mid-flight failure never leaves the fleet in a torn state."
    command_template: "enforcer-cloud-restore {snapshot} {flags}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["snapshot"],
        "properties": {
          "snapshot": {
            "type": "string",
            "description": "Absolute path to the .json.gz snapshot produced by cloud_snapshot."
          },
          "flags": {
            "type": "string",
            "default": "",
            "description": "Optional flags. '--dry-run' shows the plan, '--force' overrides drift protection, '--wipe' DEL's every enforcer:mcp:* key first (destructive)."
          }
        }
      }
    wrap_mode: none
    timeout_sec: 300

  - name: cloud_probe_commands
    description: "Enumerate which Redis commands are actually reachable through the Upstash REST proxy allowlist. Zero-payload capability discovery — sends each command with no arguments and classifies the response ('passthrough', 'unknown', 'forbidden'). Safe on production because we never actually invoke the target commands. Default probe set is the Streams family + interesting adjacent primitives that tend to show up in CVE research (DEBUG, SCRIPT, MODULE, PUBSUB, …). Useful for UEF-style capability recon before designing test cases."
    command_template: "enforcer-cloud-probe-commands --json {extra}"
    arg_schema_json: |
      {
        "type": "object",
        "properties": {
          "extra": {
            "type": "string",
            "default": "",
            "description": "Optional: space-separated list of specific commands to probe (e.g. 'XACKDEL XAUTOCLAIM XCLAIM'). Empty = probe the default Streams-focused set."
          }
        }
      }
    wrap_mode: none
    timeout_sec: 30

  # ─── GTFOBins: living-off-the-land binary lookup ────────────────────
  # 478-binary offline cache. Post-shell triage tools — given `ls /bin`
  # output on a compromised target, returns ranked exploit primitives
  # (file-read, download, reverse-shell, sudo-bypass, etc.) sorted by
  # code length. No API calls — everything's baked into the .deb.
  # Wrappers call the shipped handler in --cli mode so we don't have to
  # keep a stdio subprocess alive.

  - name: gtfobins_functions
    description: "List all 12 GTFOBins function types (shell, sudo, capabilities, file-write, download, reverse-shell, non-interactive-bind-shell, etc.) with their descriptions. Zero args, always safe to call."
    command_template: "gtfobins-mcp --cli functions"
    arg_schema_json: |
      {"type": "object", "properties": {}}
    wrap_mode: none
    timeout_sec: 10

  - name: gtfobins_lookup
    description: "Return every GTFOBins exploit function known for a specific binary, with the exact one-liner code. Use when you've spotted a candidate binary on target and want the payload."
    command_template: "gtfobins-mcp --cli lookup --binary {binary}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["binary"],
        "properties": {
          "binary": {"type": "string", "description": "Binary name, e.g. 'python3', 'vim', 'find', 'awk'."}
        }
      }
    wrap_mode: none
    timeout_sec: 10

  - name: gtfobins_triage
    description: "Post-shell triage. Given a comma-separated list of binaries present on the target (feed it `ls /bin` output) and a goal, returns ranked exploit paths sorted by code length. Goal is optional; when omitted, returns EVERY exploit primitive achievable with the available binaries."
    command_template: "gtfobins-mcp --cli triage --bins {bins} --goal {goal}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["bins"],
        "properties": {
          "bins": {
            "type": "string",
            "description": "Comma-separated list of binaries present on target, e.g. 'whois,ftp,perl,nc,lua'."
          },
          "goal": {
            "type": "string",
            "description": "Optional goal filter. Common: 'download', 'shell', 'reverse-shell', 'file-read', 'file-write', 'suid', 'sudo', 'capabilities'.",
            "default": ""
          }
        }
      }
    wrap_mode: none
    timeout_sec: 15

  - name: gtfobins_search
    description: "Fuzzy substring search across the 478 GTFOBins binaries. Useful when you've spotted 'something_python' on target and want to check what variants are in the DB."
    command_template: "gtfobins-mcp --cli search --query {query}"
    arg_schema_json: |
      {
        "type": "object",
        "required": ["query"],
        "properties": {"query": {"type": "string"}}
      }
    wrap_mode: none
    timeout_sec: 10
