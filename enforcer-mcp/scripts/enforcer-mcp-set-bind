#!/usr/bin/env bash
# enforcer-mcp-set-bind — safely change the enforcer-mcp server bind
# address in /etc/enforcer-mcp/config.yaml and restart the service.
#
# Motivation: fresh installs before 0.3.1 defaulted the `server.host`
# field to "127.0.0.1", which meant the enforcer-mcp daemon only listened
# on loopback. Remote cockpits probing over Tailscale would see the node
# as offline forever. This script flips the value in-place with a
# backup, then bounces the systemd unit so the change takes effect.
#
# Usage:
#   sudo enforcer-mcp-set-bind                # default → 0.0.0.0
#   sudo enforcer-mcp-set-bind 0.0.0.0
#   sudo enforcer-mcp-set-bind 100.64.1.23    # bind to a specific tailnet IP
#   sudo enforcer-mcp-set-bind --show         # just print the current bind
#
# Safe to re-run: no-op if already at the desired value.

set -euo pipefail

CFG="/etc/enforcer-mcp/config.yaml"
NEW_HOST=""
SHOW_ONLY=0

for arg in "$@"; do
    case "$arg" in
        --show|-s) SHOW_ONLY=1 ;;
        -h|--help)
            sed -n '2,/^set -e/p' "$0" | sed 's/^# \?//' | head -n -1
            exit 0 ;;
        *) NEW_HOST="$arg" ;;
    esac
done
[[ -z "$NEW_HOST" ]] && NEW_HOST="0.0.0.0"

if [[ ! -f "$CFG" ]]; then
    echo "config not found: $CFG (is enforcer-mcp installed?)" >&2
    exit 2
fi

# Extract current host from the `server: → host:` block. We use a
# minimal awk state machine rather than shelling out to a yaml parser
# because we can't assume `yq` is on every node.
current_host=$(awk '
    /^server:/            { in_server=1; next }
    in_server && /^[a-z]/ { in_server=0 }
    in_server && /^\s+host:/ {
        gsub(/["'"'"']/, "", $2); print $2; exit
    }
' "$CFG")

if (( SHOW_ONLY == 1 )); then
    echo "current server.host: ${current_host:-<not-set>}"
    exit 0
fi

if [[ "$current_host" == "$NEW_HOST" ]]; then
    echo "server.host is already $NEW_HOST — nothing to do."
    exit 0
fi

# Take a timestamped backup so operator can revert with `mv`.
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
cp -p "$CFG" "$CFG.bak.$STAMP"
echo "backed up $CFG → $CFG.bak.$STAMP"

# In-place edit: replace only the host: line inside the server: block.
# sed's address range `/^server:/,/^[a-z]/` keeps us from touching a
# stray `host:` in some other section.
sed -i.tmp -E '/^server:/,/^[^[:space:]]/{
    s|^([[:space:]]+host:[[:space:]]*).*$|\1"'"$NEW_HOST"'"|
}' "$CFG"
rm -f "$CFG.tmp"

echo "updated server.host: ${current_host:-<not-set>} → $NEW_HOST"

# ─── Restart the server so the new bind takes effect ───────────────────
# Fleet reality: nodes run on Debian VPSes (real systemd) AND inside Kali
# NetHunter chroots (dpkg-diverted systemctl stub + no init pid 1). We do
# a proper capability check so the systemd path fires on real init hosts
# and the chroot path bounces the process directly via kill+respawn.
has_real_systemd() {
    [ -d /run/systemd/system ] \
        && command -v systemctl >/dev/null 2>&1 \
        && [ ! -f /usr/bin/systemctl.real ]
}

if has_real_systemd \
    && systemctl list-unit-files 2>/dev/null | grep -q '^enforcer-mcp\.service'
then
    echo "restarting enforcer-mcp.service via systemd …"
    systemctl restart enforcer-mcp.service
    sleep 1
    if systemctl is-active --quiet enforcer-mcp.service; then
        echo "✓ enforcer-mcp running on ${NEW_HOST}:8765"
    else
        echo "! service failed to come up — check: journalctl -u enforcer-mcp -n 40" >&2
        exit 3
    fi
else
    # No real systemd: NetHunter chroot / minimal Alpine-adjacent /
    # dpkg-divert stub. The cockpit's autospawn is what owns the
    # process lifecycle here. We can't `systemctl restart` — but we
    # CAN find and kill any running server.py so autospawn's next
    # health-probe cycle notices unreachable + relaunches with the
    # new config.
    echo "no real systemd detected — bouncing the enforcer-mcp process directly"
    # pgrep is portable; the pattern matches only the actual python
    # invocation, not the sudo/bash wrapper (which will exit when its
    # child dies anyway).
    if command -v pgrep >/dev/null 2>&1; then
        pids=$(pgrep -f '/opt/enforcer-mcp/(\.venv/bin/)?python.*server\.py' || true)
    else
        pids=$(ps -eo pid,args 2>/dev/null \
               | awk '/\/opt\/enforcer-mcp\/(\.venv\/bin\/)?python.*server\.py/ && !/awk/ {print $1}')
    fi
    if [ -n "$pids" ]; then
        # SIGTERM first, then SIGKILL after a grace second. That mirrors
        # what systemd would do internally.
        echo "  killing pids: $pids"
        kill $pids 2>/dev/null || true
        sleep 1
        # Only SIGKILL survivors.
        for p in $pids; do
            if kill -0 "$p" 2>/dev/null; then
                kill -9 "$p" 2>/dev/null || true
            fi
        done
        echo "✓ old process(es) stopped."
        echo "  cockpit autospawn will relaunch within ~30 s on next"
        echo "  health-probe failure. Watch the // mcp tab for status."
    else
        echo "  no running server.py found — nothing to bounce."
        echo "  bring it up from the cockpit's // mcp tab (Autospawn toggle)."
    fi
fi
