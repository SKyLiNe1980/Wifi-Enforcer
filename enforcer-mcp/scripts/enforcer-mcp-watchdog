#!/bin/sh
# enforcer-mcp-watchdog — cron safety net for non-systemd nodes.
#
# The init-script supervisor already respawns server.py on crash, but it
# can't help if:
#   • the supervisor process itself was killed (OOM, stray pkill),
#   • the node rebooted and nothing re-ran the init script,
#   • the server is alive-but-wedged (accepts no connections).
#
# This script — driven by /etc/cron.d/enforcer-mcp every couple of minutes
# — covers those gaps. It's a no-op on healthy nodes.
#
# NOTE: requires cron to actually be running in the environment. On systemd
# nodes we don't install this (systemd Restart= + WantedBy handle it).

INITD=/etc/init.d/enforcer-mcp
CONFIG=/etc/enforcer-mcp/config.yaml

[ -x "$INITD" ] || exit 0

# 1) Down entirely → start it.
if ! "$INITD" status >/dev/null 2>&1; then
    "$INITD" start
    exit 0
fi

# 2) Alive but wedged → verify it actually answers /health, else restart.
#    Pull the port AND bind host straight out of the server: block in
#    config.yaml. On tailnet nodes server.host is a Tailscale IP, so a
#    hardcoded 127.0.0.1 probe would miss it and false-restart every cycle.
PORT=$(awk '/^server:/{f=1; next} /^[^[:space:]]/{f=0} f && /port:/{print $2; exit}' "$CONFIG" 2>/dev/null | tr -d '"')
[ -z "$PORT" ] && PORT=8765
HOST=$(awk '/^server:/{f=1; next} /^[^[:space:]]/{f=0} f && /host:/{print $2; exit}' "$CONFIG" 2>/dev/null | tr -d '"')
[ -z "$HOST" ] && HOST=127.0.0.1
# 0.0.0.0 is a bind-all wildcard, not a routable client target → loopback.
[ "$HOST" = "0.0.0.0" ] && HOST=127.0.0.1

if command -v curl >/dev/null 2>&1; then
    # Probe the configured bind host first (tailnet IP on most nodes), then
    # fall back to loopback before declaring the server wedged — so an IP
    # change or a bind-all config never triggers a false-positive restart.
    if ! curl -fsS -m 5 "http://$HOST:$PORT/health" >/dev/null 2>&1 \
       && ! curl -fsS -m 5 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
        "$INITD" restart
    fi
fi
exit 0
