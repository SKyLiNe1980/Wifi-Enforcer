# enforcer-cloud.env — credentials for the Redis-as-OTA registry.
#
# Copy to one of:
#   /etc/enforcer-mcp/cloud.env     (system-wide, root-only, for nodes)
#   ~/.enforcer-cloud.env           (user-level, for cockpit/dev machines)
# then `chmod 600` it.
#
# All four enforcer-cloud-* scripts will source the first file they find
# in that order, then fall back to env vars, then to --url / --token CLI
# flags. Later sources override earlier ones.
#
# ─── Which Upstash Redis DB? ─────────────────────────────────────────
# The REST URL is printed on your Upstash dashboard as "UPSTASH_REDIS_REST_URL".
ENFORCER_CLOUD_URL="https://YOUR-DB-slug.upstash.io"

# ─── Which token? ────────────────────────────────────────────────────
# Cockpit (push/rollback) needs the R/W token.
# Nodes (pull only) can use the READ-ONLY token — safer if a node is
# compromised, the attacker can't overwrite the fleet's .deb.
ENFORCER_CLOUD_TOKEN="YOUR-UPSTASH-TOKEN"

# ─── Optional: which .deb dist dir? ─────────────────────────────────
# Push uses this to find the newest .deb. Defaults to ./dist relative
# to the enforcer-mcp project root.
# ENFORCER_CLOUD_DIST_DIR="/app/enforcer-mcp/dist"
