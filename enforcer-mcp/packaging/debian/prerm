#!/bin/sh
# enforcer-mcp prerm — stop the service before files get yanked.
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Only touch systemd if it's the real deal (not a NetHunter-style
        # dpkg-divert stub). See postinst for the full rationale.
        if [ -d /run/systemd/system ] \
            && command -v systemctl >/dev/null 2>&1 \
            && [ ! -f /usr/bin/systemctl.real ]
        then
            systemctl stop enforcer-mcp.service >/dev/null 2>&1 || true
        fi
        ;;
    failed-upgrade)
        ;;
esac

exit 0
